        local body = nil

        if requestFn then
            pcall(function()
                local response =
                    requestFn({
                        Url = AVATAR_URL,
                        Method = "GET",
                        Headers = {
                            ["Accept"] = "image/png,image/*,*/*"
                        }
                    })

                if response then
                    local status =
                        response.StatusCode
                        or response.Status
                        or response.status_code

                    if status == 200
                    or response.Success == true then
                        body =
                            response.Body
                            or response.body
                    end
                end
            end)
        end

        if not body or #body < 100 then
            pcall(function()
                body = game:HttpGetAsync(AVATAR_URL)
            end)
        end

