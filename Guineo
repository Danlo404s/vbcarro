-- ============================================================
-- DANLOHUB - TEMA ROJO NEON POST-CARGA
-- Corre DESPUES de que la UI original ya fue creada.
-- Detecta el ScreenGui por sus propios textos y solo toca ese árbol.
-- ============================================================
do
    local Players = game:GetService("Players")
    local CoreGui = game:GetService("CoreGui")
    local LocalPlayer = Players.LocalPlayer
    local PlayerGui = LocalPlayer and LocalPlayer:WaitForChild("PlayerGui")

    local NEON = Color3.fromRGB(255,35,55)
    local NEON_TEXT = Color3.fromRGB(255,105,120)

    local roots = setmetatable({}, {__mode="k"})
    local watched = setmetatable({}, {__mode="k"})
    local tempConnections = {}

    local function isYellow(c)
        if typeof(c) ~= "Color3" then return false end
        local r,g,b = c.R,c.G,c.B

        -- Amarillos/dorados/naranjas del tema original.
        return r >= 0.70
            and g >= 0.42
            and b <= 0.42
            and r >= g * 0.90
            and g >= b * 1.35
    end

    local function brandingText(s)
        s = tostring(s or ""):lower()
        return s:find("danlohub",1,true)
            or s:find("bagah hub",1,true)
            or s:find("bagahhub",1,true)
            or s:find("gakuran v0.3.1",1,true)
            or s:find("script loaded",1,true)
            or s:find("autoload config",1,true)
    end

    local function recolor(obj)
        if not obj or not obj.Parent then return end

        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            pcall(function()
                if isYellow(obj.TextColor3) then
                    obj.TextColor3 = NEON_TEXT
                end
            end)
            pcall(function()
                if obj.BackgroundTransparency < 1 and isYellow(obj.BackgroundColor3) then
                    obj.BackgroundColor3 = NEON
                end
            end)

        elseif obj:IsA("Frame")
            or obj:IsA("ScrollingFrame")
            or obj:IsA("CanvasGroup") then
            pcall(function()
                if obj.BackgroundTransparency < 1 and isYellow(obj.BackgroundColor3) then
                    obj.BackgroundColor3 = NEON
                end
            end)

        elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
            pcall(function()
                if isYellow(obj.ImageColor3) then
                    obj.ImageColor3 = NEON
                end
            end)
            pcall(function()
                if obj.BackgroundTransparency < 1 and isYellow(obj.BackgroundColor3) then
                    obj.BackgroundColor3 = NEON
                end
            end)

        elseif obj:IsA("UIStroke") then
            pcall(function()
                if isYellow(obj.Color) then
                    obj.Color = NEON
                end
            end)
        end
    end

    local function watch(obj)
        if not obj or watched[obj] then return end
        watched[obj] = true
        recolor(obj)

        local function bind(prop)
            pcall(function()
                __DANLO_PARRY_TRACK(
                    obj:GetPropertyChangedSignal(prop):Connect(function()
                        task.defer(function()
                            recolor(obj)
                        end)
                    end)
                )
            end)
        end

        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            bind("TextColor3")
            bind("BackgroundColor3")
        elseif obj:IsA("Frame") or obj:IsA("ScrollingFrame") or obj:IsA("CanvasGroup") then
            bind("BackgroundColor3")
        elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
            bind("ImageColor3")
            bind("BackgroundColor3")
        elseif obj:IsA("UIStroke") then
            bind("Color")
        end
    end

    local function bindRoot(root)
        if not root or roots[root] then return end
        roots[root] = true

        watch(root)
        for _,d in ipairs(root:GetDescendants()) do
            watch(d)
        end

        __DANLO_PARRY_TRACK(
            root.DescendantAdded:Connect(function(d)
                task.defer(function()
                    watch(d)
                    for _,sub in ipairs(d:GetDescendants()) do
                        watch(sub)
                    end
                end)
            end)
        )

        -- Unos pocos repasos SOLO sobre el hub para capturar colores
        -- que la librería aplica inmediatamente después.
        task.spawn(function()
            for _=1,12 do
                if not root.Parent then break end
                for _,d in ipairs(root:GetDescendants()) do
                    recolor(d)
                end
                task.wait(0.25)
            end
        end)
    end

    local function tryClaimFromText(obj)
        if not obj or not obj.Parent then return false end
        if not (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) then
            return false
        end

        local ok, t = pcall(function() return obj.Text end)
        if not ok or not brandingText(t) then
            return false
        end

        local gui = obj:FindFirstAncestorOfClass("ScreenGui")
        if gui then
            bindRoot(gui)
            return true
        end

        -- Algunas librerías parentan directo a una carpeta/frame de CoreGui.
        local p = obj
        while p and p.Parent and p.Parent ~= CoreGui and p.Parent ~= PlayerGui do
            p = p.Parent
        end
        if p and p ~= obj then
            bindRoot(p)
            return true
        end

        return false
    end

    local function scan(container)
        if not container then return end
        for _,d in ipairs(container:GetDescendants()) do
            if tryClaimFromText(d) then
                -- puede haber ventana principal + notificaciones separadas;
                -- seguimos para encontrar ambas.
            end
        end
    end

    -- La UI ya existe aquí porque este bloque corre post-carga.
    scan(CoreGui)
    scan(PlayerGui)

    -- Ventana temporal para notificaciones/GUI que aparezcan unos segundos después.
    local function tempWatchContainer(container)
        if not container then return end

        local conn = __DANLO_PARRY_TRACK(container.DescendantAdded:Connect(function(d)
            if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                local function check()
                    if d and d.Parent and tryClaimFromText(d) then
                        recolor(d)
                    end
                end

                task.defer(check)

                local tc
                pcall(function()
                    tc = d:GetPropertyChangedSignal("Text"):Connect(check)
                end)

                if tc then
                    task.delay(6,function()
                        pcall(function() tc:Disconnect() end)
                    end)
                end
            end
        end))

        table.insert(tempConnections,conn)
    end

    tempWatchContainer(CoreGui)
    tempWatchContainer(PlayerGui)

    task.delay(8,function()
        for _,c in ipairs(tempConnections) do
            pcall(function() c:Disconnect() end)
        end
        table.clear(tempConnections)
    end)
end


-- ============================================================
-- DANLOHUB V7.1 SAFE - TITULO / FOOTER / NEGRO SIN BARRIDOS PESADOS
-- ============================================================
do
    local Players = game:GetService("Players")
    local CoreGui = game:GetService("CoreGui")
    local LocalPlayer = Players.LocalPlayer
    local PlayerGui = LocalPlayer and LocalPlayer:WaitForChild("PlayerGui")
    local ENV = (getgenv and getgenv()) or _G
    local RUN_STATE = ENV.__DANLOHUB_RUN_STATE

    local BLACK = Color3.fromRGB(0,0,0)

    local function lower(s)
        return string.lower(tostring(s or ""))
    end

    local function findHubGui(container)
        if not container then
            return nil
        end

        for _, obj in ipairs(container:GetDescendants()) do
            if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                local ok, txt = pcall(function()
                    return obj.Text
                end)

                if ok then
                    local l = lower(txt)

                    if l:find("danlohub",1,true)
                    and (l:find("gakuran",1,true) or l:find("script loaded",1,true)) then
                        local gui = obj:FindFirstAncestorOfClass("ScreenGui")
                        if gui then
                            local isOld =
                                RUN_STATE
                                and RUN_STATE.existingGuis
                                and RUN_STATE.existingGuis[gui]

                            local isLoader =
                                gui.Name == "DanloHub_BoxLoading"

                            if not isOld and not isLoader then
                                return gui
                            end
                        end
                    end
                end
            end
        end

        return nil
    end

    local function patchOnce(root)
        if not root or not root.Parent then
            return
        end

        local mainCandidate = nil

        for _, obj in ipairs(root:GetDescendants()) do
            if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                pcall(function()
                    local t = obj.Text or ""
                    local l = lower(t)

                    if l:find("danlohub",1,true) and l:find("gakuran",1,true) then
                        obj.Text = "DanloHub"

                        local p = obj.Parent
                        while p and p ~= root do
