    local function traducir(s)
        if type(s) ~= "string" or s == "" then
            return s
        end

        local d = exact[s]
        if d then
            return d
        end

        local out = s
        for _, pair in ipairs(partial) do
            local old, new = pair[1], pair[2]
            local pos = string.find(out, old, 1, true)
            if pos then
                out = string.sub(out, 1, pos - 1)
                    .. new
                    .. string.sub(out, pos + #old)
            end
        end
        return out
    end

    local watched = setmetatable({}, {__mode="k"})
    local hookedRoots = setmetatable({}, {__mode="k"})

    local function patchText(obj)
        if not obj or not obj.Parent then return end
        if not (obj:IsA("TextLabel")
            or obj:IsA("TextButton")
            or obj:IsA("TextBox")) then
            return
        end

        local function apply()
            if not obj.Parent then return end

            pcall(function()
                local old = obj.Text
                local new = traducir(old)
                if new ~= old then
                    obj.Text = new
                end
            end)

            if obj:IsA("TextBox") then
                pcall(function()
                    local old = obj.PlaceholderText
                    local new = traducir(old)
                    if new ~= old then
                        obj.PlaceholderText = new
                    end
                end)
            end
        end

        apply()

        if watched[obj] then return end
        watched[obj] = true

        -- Solo los textos del hub reciben listener, no CoreGui completo.
        pcall(function()
            __DANLO_PARRY_TRACK(
                obj:GetPropertyChangedSignal("Text"):Connect(function()
                    task.defer(apply)
                end)
            )
        end)

        if obj:IsA("TextBox") then
            pcall(function()
                __DANLO_PARRY_TRACK(
                    obj:GetPropertyChangedSignal("PlaceholderText"):Connect(function()
                        task.defer(apply)
                    end)
                )
            end)
        end
    end

    local function hookHubRoot(gui)
        if not gui or hookedRoots[gui] then return end
        hookedRoots[gui] = true

        pcall(function()
            for _, d in ipairs(gui:GetDescendants()) do
                patchText(d)
            end
        end)

        __DANLO_PARRY_TRACK(
            gui.DescendantAdded:Connect(function(d)
                if d:IsA("TextLabel")
                or d:IsA("TextButton")
                or d:IsA("TextBox") then
                    task.defer(patchText, d)
                end
            end)
        )
    end

    local function inspect(obj)
        if not obj or not obj.Parent then return end
        if not (obj:IsA("TextLabel")
            or obj:IsA("TextButton")
            or obj:IsA("TextBox")) then
            return
        end

        local ok, t = pcall(function() return obj.Text end)
        if not ok or type(t) ~= "string" then return end

        local l = string.lower(t)
        if l == "danlohub"
        or l:find("danlohub %- gakuran")
        or l:find("bagah hub %- gakuran") then
            local gui = obj:FindFirstAncestorOfClass("ScreenGui")
            if gui then
                hookHubRoot(gui)
            end
        end
    end

    -- Solo un escaneo inicial corto para localizar el hub.
    for _, root in ipairs({CoreGui, PlayerGui}) do
        if root then
            pcall(function()
                for _, d in ipairs(root:GetDescendants()) do
                    inspect(d)
                end
            end)

            __DANLO_PARRY_TRACK(
                root.DescendantAdded:Connect(function(d)
                    if d:IsA("TextLabel")
                    or d:IsA("TextButton")
                    or d:IsA("TextBox") then
                        task.defer(inspect, d)
                    end
                end)
            )
        end
    end
end


-- ============================================================
-- AUTO CLEANUP SI LA GUI PRINCIPAL DESAPARECE POR OTRO CAMINO
-- ============================================================
(function()
    local ENV =
        (getgenv and getgenv())
        or _G

    task.spawn(function()
        local started =
            os.clock()

        local targetGui =
            nil

        while os.clock() - started < 8 do
            local runState =
                ENV.__DANLOHUB_RUN_STATE

            targetGui =
                runState
                and runState.targetGui

            if targetGui
            and targetGui.Parent
            then
                break
            end

            task.wait(
                0.10
            )
        end

        if not targetGui
        or not targetGui.Parent
        then
            return
        end

        local connection

        connection =
            targetGui.AncestryChanged:
                Connect(function()
                    if targetGui.Parent then
                        return
                    end

                    if connection then
                        connection:
                            Disconnect()

                        connection =
                            nil
                    end

                    local cleanup =
                        ENV.__DanloHubParryHardCleanup

                    if type(cleanup)
                        == "function"
                    then
                        task.defer(
                            cleanup
                        )
                    end
                end)

        if type(
            ENV.__DANLO_PARRY_TRACK
        ) == "function"
        then
            ENV.__DANLO_PARRY_TRACK(
                connection
            )
        end
    end)
end)()

return __DANLO_ORIGINAL_RESULT
