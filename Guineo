    local function finish()
        if not running then
            return
        end

        running = false
        ready = true

        subtitle.Text = "Listo"

        TweenService:Create(
            barFill,
            TweenInfo.new(
                0.18,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            ),
            {
                Size =
                    UDim2.new(
                        1,
                        0,
                        1,
                        0
                    )
            }
        ):Play()

        task.wait(0.22)

        for _, obj
            in ipairs(
                panel:GetDescendants()
            )
        do
            pcall(function()
                if obj:IsA("TextLabel")
                or obj:IsA("TextButton") then
                    TweenService:Create(
                        obj,
                        TweenInfo.new(0.22),
                        {
                            TextTransparency = 1,
                            BackgroundTransparency = 1
                        }
                    ):Play()

                elseif obj:IsA("ImageLabel")
                or obj:IsA("ImageButton") then
                    TweenService:Create(
                        obj,
                        TweenInfo.new(0.22),
                        {
                            ImageTransparency = 1,
                            BackgroundTransparency = 1
                        }
                    ):Play()

                elseif obj:IsA("Frame") then
                    TweenService:Create(
                        obj,
                        TweenInfo.new(0.22),
                        {
                            BackgroundTransparency = 1
                        }
                    ):Play()

                elseif obj:IsA("UIStroke") then
                    TweenService:Create(
                        obj,
                        TweenInfo.new(0.22),
                        {
                            Transparency = 1
                        }
                    ):Play()
                end
            end)
        end

        TweenService:Create(
            panel,
            TweenInfo.new(0.22),
            {
                BackgroundTransparency = 1
            }
        ):Play()

        task.wait(0.26)

        for _, conn
            in ipairs(connections)
        do
            pcall(function()
                conn:Disconnect()
            end)
        end

        pcall(function()
            loaderGui:Destroy()
        end)

        if ENV.__DANLOHUB_V11_LOADER_CLEANUP then
            ENV.__DANLOHUB_V11_LOADER_CLEANUP = nil
        end
    end

    ENV.__DANLOHUB_V11_LOADER_CLEANUP =
        function()
            running = false

            for _, conn
                in ipairs(connections)
            do
                pcall(function()
                    conn:Disconnect()
                end)
            end

            pcall(function()
                loaderGui:Destroy()
            end)
        end

    task.spawn(function()
        while running do
            task.wait(0.05)

            local elapsed =
                os.clock() - startedAt

            -- "DanloHub v2" lo pone el parche rojo/negro al final.
            -- Mínimo visible para que el loader no parpadee.
            if RUN_STATE.ready
            and elapsed >= 1.80 then
                finish()
                break
            end

            -- Seguridad por si alguna librería cambia el footer.
            if elapsed >= 9.0 then
                finish()
                break
            end
        end
    end)
end

-- DANLOHUB BRANDING PATCH V3 - SIN BARRIDO CONTINUO / SIN LAG
-- Un solo escaneo inicial + escucha de objetos nuevos.
-- NO recorre CoreGui/PlayerGui cada 0.1s.

do
    local Players = game:GetService("Players")
    local LocalPlayer = Players.LocalPlayer

    local function rebrandText(text)
        if type(text) ~= "string" or text == "" then
            return text
        end

        local new = text
        new = new:gsub("Bagah Hub", "DanloHub")
        new = new:gsub("BagahHub", "DanloHub")
        new = new:gsub("Bagah Project", "DanloHub")
        new = new:gsub("BAGAH HUB", "DANLOHUB")
        new = new:gsub("BAGAHHUB", "DANLOHUB")
        return new
    end

    local watched = setmetatable({}, {__mode = "k"})

    local function patchTextObject(obj)
        if not obj then return end

        local isText =
            obj:IsA("TextLabel")
            or obj:IsA("TextButton")
            or obj:IsA("TextBox")

        if not isText then
            return
        end

        local function apply()
            if not obj.Parent then return end

            local ok, current = pcall(function()
                return obj.Text
            end)

            if ok and type(current) == "string" then
                local changed = rebrandText(current)
                if changed ~= current then
                    pcall(function()
                        obj.Text = changed
                    end)
                end
            end

            if obj:IsA("TextBox") then
                local okP, currentP = pcall(function()
                    return obj.PlaceholderText
                end)

                if okP and type(currentP) == "string" then
                    local changedP = rebrandText(currentP)
                    if changedP ~= currentP then
                        pcall(function()
                            obj.PlaceholderText = changedP
                        end)
                    end
                end
            end
        end

        apply()

        -- Solo ponemos listener persistente si este objeto YA contiene
        -- branding relevante. Para objetos nuevos hacemos un listener corto.
        if watched[obj] then
            return
        end
        watched[obj] = true

        local shouldWatchLong = false

        pcall(function()
            local t = obj.Text or ""
            local p = obj:IsA("TextBox") and obj.PlaceholderText or ""

            if t:find("Bagah", 1, true)
            or t:find("BAGAH", 1, true)
            or p:find("Bagah", 1, true)
            or p:find("BAGAH", 1, true) then
                shouldWatchLong = true
            end
        end)

        if shouldWatchLong then
            __DANLO_PARRY_TRACK(obj:GetPropertyChangedSignal("Text"):Connect(apply))

            if obj:IsA("TextBox") then
                __DANLO_PARRY_TRACK(obj:GetPropertyChangedSignal("PlaceholderText"):Connect(apply))
            end
        else
            -- Muchas librerías asignan el texto justo después de crear el objeto.
            -- Revisamos solo unas pocas veces, NO hacemos un barrido global.
            task.defer(apply)
            task.delay(0.05, apply)
            task.delay(0.20, apply)
            task.delay(0.75, apply)
        end
    end

    local roots = {}

    pcall(function()
        roots[#roots + 1] = game:GetService("CoreGui")
    end)

    task.spawn(function()
        local pg = LocalPlayer:WaitForChild("PlayerGui")
        roots[#roots + 1] = pg

        -- Escaneo inicial UNA SOLA VEZ.
        for _, root in ipairs(roots) do
            pcall(function()
                for _, obj in ipairs(root:GetDescendants()) do
                    patchTextObject(obj)
                end
            end)

            __DANLO_PARRY_TRACK(
                root.DescendantAdded:Connect(function(obj)
                    patchTextObject(obj)
                end)
            )
        end
    end)
end


-- Filtro local y específico para el fallo de __namecall de DanloHub.
-- No oculta otros warnings del juego/executor.
local __DANLO_RAW_WARN = warn
local __DANLO_NAMECALL_HOOK_FAILED = false

local warn = function(...)
    local parts = {}
    for i = 1, select("#", ...) do
        parts[i] = tostring(select(i, ...))
    end

    local msg = table.concat(parts, " ")
    local lower = string.lower(msg)

    if lower:find("danlohub", 1, true)
    and lower:find("namecall", 1, true)
    and lower:find("hook failed", 1, true) then
        __DANLO_NAMECALL_HOOK_FAILED = true
        return
    end

    return __DANLO_RAW_WARN(...)
end

-- Compatibilidad ligera del hook: evita intentos repetidos y spam de errores.
local __DANLO_NAMECALL_HOOK_TRIED = false
local function __DANLO_TRY_NAMECALL_HOOK(fn)
    if __DANLO_NAMECALL_HOOK_TRIED
    or __DANLO_NAMECALL_HOOK_FAILED then
        return
    end

    __DANLO_NAMECALL_HOOK_TRIED = true

    if type(hookmetamethod) ~= "function"
    or type(getnamecallmethod) ~= "function" then
        __DANLO_NAMECALL_HOOK_FAILED = true
        return
    end

