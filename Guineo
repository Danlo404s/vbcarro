                                mainCandidate = p
                                break
                            end
                            p = p.Parent
                        end
                    end

                    if l:find("gakuran v0.3.1",1,true)
                    or (l:find("danlohub",1,true) and l:find("v0.3.1",1,true))
                    or (l:find("danlohub",1,true) and l:find("|",1,true)) then
                        obj.Text = "DanloHub v2"
                    end
                end)
            end
        end

        if mainCandidate then
            pcall(function()
                mainCandidate.BackgroundColor3 = BLACK
            end)

            -- Solo paneles directos/segundo nivel del hub.
            for _, child in ipairs(mainCandidate:GetDescendants()) do
                if child:IsA("Frame") then
                    pcall(function()
                        local size = child.AbsoluteSize

                        if size.X >= 180 and size.Y >= 100
                        and child.BackgroundTransparency < 0.95 then
                            child.BackgroundColor3 = BLACK
                        end
                    end)
                end
            end
        end

        if RUN_STATE then
            RUN_STATE.targetGui = root
        end
    end

    local function isRedColor(c)
        return typeof(c) == "Color3"
            and c.R >= 0.88
            and c.G <= 0.30
            and c.B <= 0.40
    end

    local function rootHasRedTheme(root)
        if not root or not root.Parent then
            return false
        end

        local hits = 0

        for _, obj in ipairs(root:GetDescendants()) do
            if obj:IsA("UIStroke") then
                if isRedColor(obj.Color) then
                    hits += 1
                end
            elseif obj:IsA("TextLabel") or obj:IsA("TextButton") then
                pcall(function()
                    if isRedColor(obj.TextColor3) then
                        hits += 1
                    end
                end)
                pcall(function()
                    if obj.BackgroundTransparency < 1
                    and isRedColor(obj.BackgroundColor3) then
                        hits += 1
                    end
                end)
            elseif obj:IsA("Frame") or obj:IsA("ScrollingFrame") then
                pcall(function()
                    if obj.BackgroundTransparency < 1
                    and isRedColor(obj.BackgroundColor3) then
                        hits += 1
                    end
                end)
            elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
                pcall(function()
                    if isRedColor(obj.ImageColor3) then
                        hits += 1
                    end
                end)
            end

            if hits >= 4 then
                return true
            end
        end

        return false
    end

    local function markReadyWhenRed(root)
        if not RUN_STATE or not root or not root.Parent then
            return
        end

        local function check()
            if RUN_STATE.ready then
                return
            end

            if rootHasRedTheme(root) then
                RUN_STATE.targetGui = root
                RUN_STATE.ready = true
            end
        end

        check()
        task.delay(0.05, check)
        task.delay(0.15, check)
        task.delay(0.30, check)
        task.delay(0.55, check)
        task.delay(0.90, check)
        task.delay(1.30, check)
    end

    task.delay(0.25, function()
        local root = findHubGui(CoreGui) or findHubGui(PlayerGui)
        if root then
            patchOnce(root)
            markReadyWhenRed(root)
        end
    end)

    task.delay(1.0, function()
        local root = findHubGui(CoreGui) or findHubGui(PlayerGui)
        if root then
            patchOnce(root)
            markReadyWhenRed(root)
        end
    end)
end



