-- ============================================================
-- DANLOHUBPARRY - HARD CLEANUP / FPS LIFECYCLE
--
-- Corrige acumulación al hacer:
-- abrir -> "Descargar DanloHub" -> abrir -> cerrar -> abrir.
--
-- Registra conexiones auxiliares persistentes de esta versión y las
-- desconecta al descargar. También limpia la ejecución anterior si
-- este archivo se vuelve a ejecutar.
-- ============================================================
(function()
    local ENV =
        (getgenv and getgenv())
        or _G

    if type(ENV.__DanloHubParryHardCleanup)
        == "function"
    then
        pcall(
            ENV.__DanloHubParryHardCleanup
        )
    end

    local life = {
        alive = true,
        connections = {}
    }

    ENV.__DanloHubParryLife =
        life

    ------------------------------------------------
    -- NAMECALL BASELINE
    --
    -- Montamos un passthrough ANTES del core MoonVeil.
    -- Si DanloHubParry instala luego su propio __namecall,
    -- al descargar restauramos directamente el __namecall que
    -- existía antes de abrir Parry, en lugar de dejar la cadena.
    ------------------------------------------------
    local originalHookMetamethod =
        hookmetamethod

    local previousNamecall =
        nil

    local namecallGuardInstalled =
        false

    if type(originalHookMetamethod)
        == "function"
    then
        pcall(function()
            local wrap =
                newcclosure
                or function(fn)
                    return fn
                end

            local passthrough

            passthrough =
                wrap(function(self, ...)
                    if previousNamecall then
                        return previousNamecall(
                            self,
                            ...
                        )
                    end
                end)

            local old =
                originalHookMetamethod(
                    game,
                    "__namecall",
                    passthrough
                )

            if type(old)
                == "function"
            then
                previousNamecall =
                    old

                namecallGuardInstalled =
                    true
            end
        end)
    end

    ENV.__DANLO_PARRY_TRACK =
        function(connection)
            if connection then
                if life.alive then
                    table.insert(
                        life.connections,
                        connection
                    )
                else
                    pcall(function()
                        connection:
                            Disconnect()
                    end)
                end
            end

            return connection
        end

    local function destroyNamedGui(
        parent,
        name
    )
        if not parent then
            return
        end

        local obj =
            parent:
                FindFirstChild(
                    name
                )

        if obj then
            pcall(function()
                obj:
                    Destroy()
            end)
        end
    end

    local function cleanup()
        if not life.alive then
            return
        end

        life.alive =
            false

        for _, connection in ipairs(
            life.connections
        ) do
            pcall(function()
                connection:
                    Disconnect()
            end)
        end

        table.clear(
            life.connections
        )

        ------------------------------------------------
        -- RESTAURAR __namecall PRE-PARRY
        ------------------------------------------------
        if namecallGuardInstalled
        and previousNamecall
        and type(originalHookMetamethod)
            == "function"
        then
            pcall(function()
                originalHookMetamethod(
                    game,
                    "__namecall",
                    previousNamecall
                )
            end)

            namecallGuardInstalled =
                false
        end

        -- Loader propio.
        if type(
            ENV.__DANLOHUB_V11_LOADER_CLEANUP
        ) == "function"
        then
            pcall(
                ENV.__DANLOHUB_V11_LOADER_CLEANUP
            )
        end

        -- Auxiliares creados por DanloHubParry.
        local Players =
            game:GetService(
                "Players"
            )

        local CoreGui =
            game:GetService(
                "CoreGui"
            )

        local player =
            Players.LocalPlayer

        local PlayerGui =
            player
            and player:
                FindFirstChildOfClass(
                    "PlayerGui"
                )

        local helperNames = {
            "DanloHub_BoxLoading",
            "DanloTargetLockUI",
            "DanloHubPianoMobile",
            "DanloHub_FPSDisplay"
        }

        local character =
            player
            and player.Character

        if character then
            for _, name in ipairs({
                "AutoFightGyro",
                "DanloFlyBV",
                "DanloFlyBG"
            }) do
                local obj =
                    character:
                        FindFirstChild(
                            name,
                            true
                        )

                if obj then
                    pcall(function()
                        obj:
                            Destroy()
                    end)
                end
            end
        end

        for _, name in ipairs(
            helperNames
        ) do
            destroyNamedGui(
                CoreGui,
                name
            )

            destroyNamedGui(
                PlayerGui,
                name
            )
        end

        if ENV.__DanloHubParryLife
            == life
        then
            ENV.__DanloHubParryLife =
                nil
        end
    end

    ENV.__DanloHubParryHardCleanup =
        cleanup
end)()

